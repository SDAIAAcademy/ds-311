 "proposed": [
  {
   "rule": "One row per complaint id",
   "dimension": "uniqueness",
   "table": "complaints",
   "attributes": "complaint_id",
   "owner": "Abdulelah Al-Batal",
   "threshold": "0.5%",
   "reason": "duplicates inflate the rate"
  },
  {
   "rule": "Every complaint has a known region",
   "dimension": "completeness",
   "table": "complaints",
   "attributes": "region_code",
   "owner": "Hatoon Al-Furaih",
   "threshold": "3%",
   "reason": "the rate is published by region"
  },
  {
   "rule": "Region code is in the regions table",
   "dimension": "validity",
   "table": "complaints",
   "attributes": "region_code",
   "owner": "Hatoon Al-Furaih",
   "threshold": "3%",
   "reason": "unknown regions drop out of the rate"
  },
  {
   "rule": "Category code is one of the six",
   "dimension": "validity",
   "table": "complaints",
   "attributes": "category_code",
   "owner": "Khulood Bin Saedan",
   "threshold": "1%",
   "reason": "the guideline has six codes"
  },
  {
   "rule": "Closed on or after received",
   "dimension": "consistency",
   "table": "complaints",
   "attributes": "received_date, closed_date",
   "owner": "Abdulelah Al-Batal",
   "threshold": "0.5%",
   "reason": "days to close must not be negative"
  },
  {
   "rule": "No amount above SAR 50,000; monthly median stable by channel",
   "dimension": "accuracy",
   "table": "complaints",
   "attributes": "amount_sar",
   "owner": "Hatoon Al-Furaih",
   "threshold": "0.1%",
   "reason": "a unit error changes every amount figure"
  },
  {
   "rule": "No complaint after the extract date",
   "dimension": "validity",
   "table": "complaints",
   "attributes": "received_date",
   "owner": "Abdulelah Al-Batal",
   "threshold": "0.1%",
   "reason": "future dates are entry errors"
  },
  {
   "rule": "Every action belongs to a complaint",
   "dimension": "consistency",
   "table": "actions",
   "attributes": "complaint_id",
   "owner": "Abdulelah Al-Batal",
   "threshold": "1%",
   "reason": "orphan actions distort closure counts"
  },
  {
   "rule": "Newest complaint within ten days of the extract",
   "dimension": "timeliness",
   "table": "complaints",
   "attributes": "received_date",
   "owner": "Hatoon Al-Furaih",
   "threshold": "0",
   "reason": "a stale extract understates the month"
  }
 ]
}